---
HeaderFilterRegex: '^(include/neo|test|benchmark)/'
ExcludeHeaderFilterRegex: '(^benchmark/Perf\.hpp$|(^|/)include/neo/third_party/)'

# misc-include-cleaner treats the facades' IWYU export pragmas as the public include surface.
# bugprone checks run except where they flag deliberate code: swappable parameters, noexcept logging, UTF bit
# operations, timing arithmetic, fixed seeds, casts that widen in 128-bit variants and separately sized views.
# The slower clang-analyzer checks run in their own Quality job through CLANG_TIDY_CHECKS.
Checks: >
  -*,
  misc-include-cleaner,
  readability-braces-around-statements,
  readability-simplify-boolean-expr,
  misc-unused-parameters,
  readability-else-after-return,
  readability-qualified-auto,
  readability-redundant-access-specifiers,
  modernize-use-override,
  modernize-use-using,
  modernize-use-auto,
  -cppcoreguidelines-pro-type-cstyle-cast,
  modernize-loop-convert,
  performance-inefficient-vector-operation,
  modernize-use-nullptr,
  performance-unnecessary-copy-initialization,
  cppcoreguidelines-pro-type-member-init,
  readability-make-member-function-const,
  modernize-use-equals-default,
  readability-redundant-inline-specifier,
  misc-use-internal-linkage,
  misc-use-anonymous-namespace,
  modernize-use-nodiscard,
  modernize-use-emplace,
  readability-isolate-declaration,
  readability-redundant-string-init,
  cppcoreguidelines-prefer-member-initializer,
  modernize-return-braced-init-list,
  modernize-use-trailing-return-type,
  google-readability-casting,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-signed-bitwise,
  -bugprone-narrowing-conversions,
  -bugprone-random-generator-seed,
  -bugprone-misplaced-widening-cast,
  -bugprone-suspicious-stringview-data-usage

CheckOptions:
  - key: modernize-use-trailing-return-type.TransformLambdas
    value: none
  # Third-party include layouts are not ours to fix; patterns match anywhere in a header's real path.
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'deps/(cppjieba|limonp)/.*;include/neo/third_party/.*'
