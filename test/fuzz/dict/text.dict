# Tokens for harnesses that segment UTF-8 text: separators, dictionary words, ASCII runs and UTF-8 edges.
# 0xFF never occurs in valid UTF-8; several harnesses split their input at it.

# Separators the segmenters split at, including the full-width period and comma.
" "
"\x0A"
"\x0D\x0A"
"\x09"
"\xE3\x80\x82"
"\xEF\xBC\x8C"

# Words of the small and repository dictionaries: 北京, 清华大学, 大学, 来到, 我, 杭研, 小明.
"\xE5\x8C\x97\xE4\xBA\xAC"
"\xE6\xB8\x85\xE5\x8D\x8E\xE5\xA4\xA7\xE5\xAD\xA6"
"\xE5\xA4\xA7\xE5\xAD\xA6"
"\xE6\x9D\xA5\xE5\x88\xB0"
"\xE6\x88\x91"
"\xE6\x9D\xAD\xE7\xA0\x94"
"\xE5\xB0\x8F\xE6\x98\x8E"

# ASCII runs and the connectors and suffixes the HMM and style paths treat specially.
"abc"
"123"
"3.14"
"%"
"+"
"#"
"-"
"_"
"."

# Part-of-speech tags.
"n"
"nr"
"ns"
"nz"
"v"
"eng"
"x"
"m"

# Valid UTF-8 at each length boundary, an emoji, then invalid sequences: overlong, surrogate, above U+10FFFF,
# a lone continuation byte and the part separator.
"\xC2\x80"
"\xDF\xBF"
"\xE0\xA0\x80"
"\xEF\xBF\xBF"
"\xF0\x90\x80\x80"
"\xF4\x8F\xBF\xBF"
"\xF0\x9F\x98\x80"
"\xC0\x80"
"\xED\xA0\x80"
"\xF4\x90\x80\x80"
"\x80"
"\xFF"
